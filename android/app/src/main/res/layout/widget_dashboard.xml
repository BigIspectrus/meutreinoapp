<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginBottom="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widgetTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Resumo do dia" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="#F3F5FC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widgetStatusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/widgetConfigure" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⋮" android:textSize="23sp" android:textColor="#D9E2F8" android:contentDescription="Configurar este widget" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:clipChildren="true">
        <LinearLayout android:id="@+id/widgetNutritionSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:id="@+id/widgetNutritionKcal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="27sp" android:textColor="#F3F5FC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:text="— kcal" />
                    <TextView android:id="@+id/widgetNutritionBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#C2CDF1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
                    <TextView android:id="@+id/widgetNutritionGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
                </LinearLayout>
                <FrameLayout android:id="@+id/widgetNutritionRingBox" android:layout_width="68dp" android:layout_height="68dp" android:layout_marginStart="8dp" android:visibility="gone">
                    <ImageView android:id="@+id/widgetNutritionRing" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/widgetNutritionPercent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="#DCF0FF" android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
            <ProgressBar android:id="@+id/widgetNutritionProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="1000" android:progressTint="#AAC5FF" android:progressBackgroundTint="#333D52" />
            <LinearLayout android:id="@+id/widgetMacros" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="9dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" >
                    <TextView android:id="@+id/widgetProteinGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Proteína" />
                    <TextView android:id="@+id/widgetNutritionProtein" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#ADC8FF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:layout_marginTop="3dp" />
                    <ProgressBar android:id="@+id/widgetProteinProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="1000" android:progressTint="#ADC8FF" android:progressBackgroundTint="#333D52" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="7dp">
                    <TextView android:id="@+id/widgetCarbsGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Carboidratos" />
                    <TextView android:id="@+id/widgetNutritionCarbs" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#84E5BC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:layout_marginTop="3dp" />
                    <ProgressBar android:id="@+id/widgetCarbsProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="1000" android:progressTint="#84E5BC" android:progressBackgroundTint="#333D52" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="7dp">
                    <TextView android:id="@+id/widgetFatGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Gordura" />
                    <TextView android:id="@+id/widgetNutritionFat" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FFD18A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:layout_marginTop="3dp" />
                    <ProgressBar android:id="@+id/widgetFatProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="1000" android:progressTint="#FFD18A" android:progressBackgroundTint="#333D52" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widgetHydration" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="7dp" android:visibility="gone">
                <TextView android:id="@+id/widgetHydrationTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#99DDF5" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
                <ProgressBar android:id="@+id/widgetHydrationProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="1000" android:progressTint="#99DDF5" android:progressBackgroundTint="#333D52" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widgetTrainingSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="3dp">
            <TextView android:id="@+id/widgetWorkout" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="#F3F5FC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
            <TextView android:id="@+id/widgetSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
            <ProgressBar android:id="@+id/widgetProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="100" android:progressTint="#B5A9FF" android:progressBackgroundTint="#333D52" />
            <LinearLayout android:id="@+id/widgetTrainingStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:id="@+id/widgetStatLeftValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#F3F5FC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
                    <TextView android:id="@+id/widgetStatLeftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:id="@+id/widgetStatRightValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#F3F5FC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
                    <TextView android:id="@+id/widgetStatRightLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widgetMovementSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="3dp">
            <TextView android:id="@+id/widgetSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="25sp" android:textColor="#F3F5FC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
            <ProgressBar android:id="@+id/widgetStepsProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="100" android:progressTint="#84E5BC" android:progressBackgroundTint="#333D52" />
            <TextView android:id="@+id/widgetStepsGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#84E5BC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widgetMovementWeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#DFE5F4" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widgetMovementRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AFB9CD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/widgetMovementGoals" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#84E5BC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetFoodActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="5dp">
        <TextView android:id="@+id/widgetTextMealButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"  android:background="@drawable/widget_text_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="Por texto" android:textColor="#151B2D" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false" android:contentDescription="Registrar refeição de hoje por texto" />
        <TextView android:id="@+id/widgetMealButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/widget_secondary_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="+ Alimento" android:textColor="#DFE5F4" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false" android:contentDescription="Buscar alimento para registrar hoje" />
        <TextView android:id="@+id/widgetWaterButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/widget_secondary_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="Água" android:textColor="#99DDF5" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" android:contentDescription="Abrir o registro de água de hoje" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetReadyActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="5dp">
        <TextView android:id="@+id/widgetReadyMealButton" android:layout_width="match_parent" android:layout_height="44dp"   android:background="@drawable/widget_secondary_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="Refeições prontas" android:textColor="#DFE5F4" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false"  />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetOtherActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="5dp">
        <TextView android:id="@+id/widgetButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"  android:background="@drawable/widget_text_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="Iniciar treino" android:textColor="#151B2D" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false"  />
        <TextView android:id="@+id/widgetBlankButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/widget_secondary_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="Em branco" android:textColor="#DFE5F4" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false" android:contentDescription="Iniciar treino em branco" />
        <TextView android:id="@+id/widgetMovementButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"  android:background="@drawable/widget_text_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="Ver cardio e passos" android:textColor="#151B2D" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false"  />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetCombinedActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="5dp">
        <TextView android:id="@+id/widgetCombinedButton" android:layout_width="match_parent" android:layout_height="44dp"   android:background="@drawable/widget_text_button" android:gravity="center" android:paddingHorizontal="5dp" android:text="Refeição por texto" android:textColor="#151B2D" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:includeFontPadding="false"  />
    </LinearLayout>
</LinearLayout>
