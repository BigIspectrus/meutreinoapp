<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@mipmap/ic_launcher" android:contentDescription="TreinoApp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TREINOAPP" android:textSize="10sp" android:textStyle="bold" android:textColor="#83AEFF" />
            <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Combinado" android:textSize="12sp" android:textColor="#DCE8FF" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widgetStatusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:background="@drawable/widget_chip_background" android:text="HOJE" android:textSize="9sp" android:textColor="#DCE8FF" />
        <TextView android:id="@+id/widgetConfigure" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⋮" android:textSize="25sp" android:textColor="#DCE8FF" android:contentDescription="Configurar este widget" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetTrainingSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
        <TextView android:id="@+id/widgetWorkout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Treino" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widgetSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Próximo treino" android:textSize="11sp" android:textColor="#AEB8D8" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:id="@+id/widgetProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="7dp" android:max="100" android:progressTint="#4F8EF7" android:progressBackgroundTint="#26314F" />
        <LinearLayout android:id="@+id/widgetTrainingStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:padding="8dp" android:background="@drawable/widget_stat_background">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widgetStatLeftValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0/4" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/widgetStatLeftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="treinos na semana" android:textSize="10sp" android:textColor="#AEB8D8" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widgetStatRightValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/widgetStatRightLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="dias seguidos" android:textSize="10sp" android:textColor="#AEB8D8" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetNutritionSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALIMENTAÇÃO · HOJE" android:textSize="10sp" android:textColor="#AEB8D8" />
        <TextView android:id="@+id/widgetNutritionKcal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 kcal consumidas" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:id="@+id/widgetMacros" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal">
            <TextView android:id="@+id/widgetNutritionProtein" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="P 0 g" android:textSize="11sp" android:textColor="#8AB4FF" />
            <TextView android:id="@+id/widgetNutritionCarbs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="C 0 g" android:textSize="11sp" android:textColor="#F7C94F" />
            <TextView android:id="@+id/widgetNutritionFat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="G 0 g" android:textSize="11sp" android:textColor="#F7A875" />
        </LinearLayout>
        <ProgressBar android:id="@+id/widgetNutritionProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp" android:max="100" android:progressTint="#8AB4FF" android:progressBackgroundTint="#26314F" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetMovementSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PASSOS · HOJE" android:textSize="10sp" android:textColor="#AEB8D8" />
        <TextView android:id="@+id/widgetSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— passos" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:id="@+id/widgetStepsProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="7dp" android:max="100" android:progressTint="#65D9AC" android:progressBackgroundTint="#26314F" />
        <TextView android:id="@+id/widgetMovementWeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="— min · — sessões na semana" android:textSize="12sp" android:textColor="#DCE8FF" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widgetMovementGoals" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="11sp" android:textColor="#65D9AC" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widgetMovementRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Abra o app para atualizar" android:textSize="10sp" android:textColor="#AEB8D8" android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widgetButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:text="INICIAR TREINO" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button_background" android:maxLines="2" />
        <TextView android:id="@+id/widgetMealButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:padding="4dp" android:text="+ REFEIÇÃO" android:contentDescription="Adicionar refeição de hoje" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button_background" android:maxLines="2" />
        <TextView android:id="@+id/widgetMovementButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:padding="4dp" android:text="MOVIMENTO" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button_background" android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
