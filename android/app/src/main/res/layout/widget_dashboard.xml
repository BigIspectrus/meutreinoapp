<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TREINOAPP" android:textSize="9sp" android:letterSpacing="0.12" android:textStyle="bold" android:textColor="#99C4FF" android:includeFontPadding="false" />
            <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Resumo do dia" android:textSize="12sp" android:textColor="#F2F6FF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:id="@+id/widgetStatusChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="7dp" android:paddingVertical="5dp" android:background="@drawable/widget_chip_background" android:text="HOJE" android:textSize="9sp" android:textStyle="bold" android:textColor="#C9DCF7" android:maxLines="1" />
        <TextView android:id="@+id/widgetConfigure" android:layout_width="36dp" android:layout_height="34dp" android:gravity="center" android:text="⋮" android:textSize="24sp" android:textColor="#C9DCF7" android:contentDescription="Configurar este widget" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widgetTrainingSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <TextView android:id="@+id/widgetWorkout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Treino" android:textSize="20sp" android:textStyle="bold" android:textColor="#F2F6FF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/widgetSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Próximo treino" android:textSize="10sp" android:textColor="#99AEC8" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <ProgressBar android:id="@+id/widgetProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:max="100" android:progressTint="#99C4FF" android:progressBackgroundTint="#2A3D54" />
            <LinearLayout android:id="@+id/widgetTrainingStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false" android:padding="8dp" android:background="@drawable/widget_stat_background">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widgetStatLeftValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0/4" android:textSize="17sp" android:textStyle="bold" android:textColor="#F2F6FF" android:includeFontPadding="false" />
                    <TextView android:id="@+id/widgetStatLeftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="treinos na semana" android:textSize="10sp" android:textColor="#99AEC8" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widgetStatRightValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textSize="17sp" android:textStyle="bold" android:textColor="#F2F6FF" android:includeFontPadding="false" />
                    <TextView android:id="@+id/widgetStatRightLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="dias seguidos" android:textSize="10sp" android:textColor="#99AEC8" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widgetNutritionSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <FrameLayout android:id="@+id/widgetNutritionRingBox" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginEnd="12dp" android:visibility="gone">
                    <ImageView android:id="@+id/widgetNutritionRing" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/widgetNutritionPercent" android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textSize="17sp" android:textStyle="bold" android:textColor="#C5DEFF" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="17sp" android:includeFontPadding="false" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="da meta" android:textSize="9sp" android:textColor="#99AEC8" android:includeFontPadding="false" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/widgetNutritionKcal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— kcal" android:textSize="26sp" android:textStyle="bold" android:textColor="#F2F6FF" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" />
                    <TextView android:id="@+id/widgetNutritionGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Registros de hoje" android:textSize="11sp" android:textColor="#99AEC8" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
                    <TextView android:id="@+id/widgetNutritionBalance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textColor="#BBD6F8" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <ProgressBar android:id="@+id/widgetNutritionProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:max="100" android:progressTint="#99C4FF" android:progressBackgroundTint="#2A3D54" />
            <LinearLayout android:id="@+id/widgetMacros" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="7dp" android:background="@drawable/widget_macro_protein" android:orientation="vertical">
                    <TextView android:id="@+id/widgetNutritionProtein" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="P — g" android:textSize="12sp" android:textStyle="bold" android:textColor="#99C4FF" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:includeFontPadding="false" />
                    <TextView android:id="@+id/widgetProteinGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Proteína" android:textSize="9sp" android:textColor="#A9BCD6" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
                    <ProgressBar android:id="@+id/widgetProteinProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:max="100" android:progressTint="#99C4FF" android:progressBackgroundTint="#2A3D54" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="5dp" android:padding="7dp" android:background="@drawable/widget_macro_carbs" android:orientation="vertical">
                    <TextView android:id="@+id/widgetNutritionCarbs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="C — g" android:textSize="12sp" android:textStyle="bold" android:textColor="#7BE0BA" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:includeFontPadding="false" />
                    <TextView android:id="@+id/widgetCarbsGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Carboidrato" android:textSize="9sp" android:textColor="#A6C8BD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
                    <ProgressBar android:id="@+id/widgetCarbsProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:max="100" android:progressTint="#7BE0BA" android:progressBackgroundTint="#29433E" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="7dp" android:background="@drawable/widget_macro_fat" android:orientation="vertical">
                    <TextView android:id="@+id/widgetNutritionFat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="G — g" android:textSize="12sp" android:textStyle="bold" android:textColor="#F5C582" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp" android:includeFontPadding="false" />
                    <TextView android:id="@+id/widgetFatGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Gordura" android:textSize="9sp" android:textColor="#D6BDA0" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
                    <ProgressBar android:id="@+id/widgetFatProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:max="100" android:progressTint="#F5C582" android:progressBackgroundTint="#483E30" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widgetMovementSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PASSOS · HOJE" android:textSize="9sp" android:letterSpacing="0.08" android:textColor="#99AEC8" android:includeFontPadding="false" />
            <TextView android:id="@+id/widgetSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="— passos" android:textSize="19sp" android:textStyle="bold" android:textColor="#F2F6FF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <ProgressBar android:id="@+id/widgetStepsProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="100" android:progressTint="#7BE0BA" android:progressBackgroundTint="#2A3D54" />
            <TextView android:id="@+id/widgetMovementWeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="— min · — sessões na semana" android:textSize="11sp" android:textColor="#D1DEF0" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/widgetMovementGoals" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:textColor="#7BE0BA" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/widgetMovementRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Abra o app para atualizar" android:textSize="9sp" android:textColor="#99AEC8" android:maxLines="3" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetFoodActions" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/widgetMealButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:padding="5dp" android:text="＋ Alimento" android:contentDescription="Adicionar alimento à refeição de hoje" android:textSize="11sp" android:textStyle="bold" android:textColor="#D5E5FA" android:background="@drawable/widget_secondary_button" android:maxLines="2" />
        <TextView android:id="@+id/widgetTextMealButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="5dp" android:text="✎ Por texto" android:contentDescription="Registrar refeição de hoje por texto" android:textSize="12sp" android:textStyle="bold" android:textColor="#102239" android:background="@drawable/widget_text_button" android:maxLines="2" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetOtherActions" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widgetButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:text="Iniciar treino" android:textSize="11sp" android:textStyle="bold" android:textColor="#D5E5FA" android:background="@drawable/widget_secondary_button" android:maxLines="2" />
        <TextView android:id="@+id/widgetMovementButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:padding="4dp" android:text="Movimento" android:textSize="11sp" android:textStyle="bold" android:textColor="#D5E5FA" android:background="@drawable/widget_secondary_button" android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
